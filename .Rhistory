date_labels = "%Y",
expand = c(0, 0) # Supprime l'espace vide aux extrémités de l'axe
) +
labs(
title = "Évolution des rendements journaliers de l'action Google",
subtitle = "Mise en évidence des régimes de volatilité (2004 - 2023)",
x = NULL, # Rend l'axe X plus épuré
y = "Rendement journalier",
caption = "Sources des données : Yahoo Finance"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 14, margin = margin(b = 5)),
plot.subtitle = element_text(color = "grey40", size = 11, margin = margin(b = 15)),

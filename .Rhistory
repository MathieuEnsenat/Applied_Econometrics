library(readr)
dataset <- read_csv(NULL)
# 1. Lecture du fichier Excel
# On saute les 14 premières lignes (le texte explicatif et l'en-tête ",Mom")
# col_names = FALSE permet d'éviter que la première ligne de données ne devienne le nom de la colonne
raw_mom <- read_csv("F-F_Momentum_Factor_daily.csv", skip = 14, col_names = FALSE)
View(raw_mom)
# 2. Nettoyage et formatage de la base de données
df_mom_clean <- raw_mom %>%
# Le fichier lit souvent tout dans la première colonne (colonne 1).
# On sépare cette chaîne de caractères en deux colonnes grâce à la virgule
separate(col = 1, into = c("date_raw", "Momentum_perc"), sep = ",") %>%
mutate(
# On supprime les espaces potentiels avec str_trim()
date_raw = str_trim(date_raw),
Momentum_perc = as.numeric(str_trim(Momentum_perc)),
# 3. Formatage de la date
# La fonction ymd() de lubridate transforme automatiquement "19261103" en "1926-11-03" (format Date de R)
date = ymd(date_raw),
# 4. Traitement des valeurs extrêmes/manquantes (-99.99)
Momentum_perc = ifelse(Momentum_perc <= -99, NA, Momentum_perc),
# 5. Conversion en décimal pour la régression (0.55% devient 0.0055)
WML = Momentum_perc / 100
) %>%
# On retire les éventuelles lignes vides et on ne garde que les colonnes finales propres
filter(!is.na(date)) %>%
select(date, WML)
View(df_mom_clean)
# Aperçu du résultat propre
head(df_mom_clean)
# 2. Nettoyage et formatage de la base de données
df_mom_clean <- raw_mom %>%
# Le fichier lit souvent tout dans la première colonne (colonne 1).
# On sépare cette chaîne de caractères en deux colonnes grâce à la virgule
separate(col = 1, into = c("date_raw", "Momentum_perc"), sep = ",") %>%
mutate(
# On supprime les espaces potentiels avec str_trim()
date_raw = str_trim(date_raw),
Momentum_perc = as.numeric(str_trim(Momentum_perc)),
# 3. Formatage de la date
# La fonction ymd() de lubridate transforme automatiquement "19261103" en "1926-11-03" (format Date de R)
date = ymd(date_raw),
# 4. Traitement des valeurs extrêmes/manquantes (-99.99)
Momentum_perc = ifelse(Momentum_perc >= -99, NA, Momentum_perc),
# 5. Conversion en décimal pour la régression (0.55% devient 0.0055)
WML = Momentum_perc / 100
) %>%
# On retire les éventuelles lignes vides et on ne garde que les colonnes finales propres
filter(!is.na(date)) %>%
select(date, WML)

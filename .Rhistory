raw_mom <- read_csv("F-F_Momentum_Factor_daily.xlsx", col_names = FALSE)
raw_mom <- read_csv("F-F_Momentum_Factor_daily.csv", col_names = FALSE)
df_mom_clean <- raw_mom %>%
# 1. On fusionne toutes les colonnes lues par Excel en une seule chaîne de caractères
# (Si Excel a déjà séparé les dates et les rendements, on les recolle)
unite("brut", everything(), sep = " ", na.rm = TRUE) %>%
# 2. On remplace les virgules par des espaces pour tout uniformiser
mutate(brut = str_replace_all(brut, ",", " ")) %>%
# 3. On ne garde strictement que les lignes qui commencent par une date (19xx ou 20xx)
# Cela supprime automatiquement tout le texte explicatif du début et la fin
filter(str_detect(brut, "^(19|20)\\d{6}")) %>%
# 4. On extrait la date (8 chiffres consécutifs) et le rendement (chiffres, points ou tirets)
# \s+ permet de gérer n'importe quel nombre d'espaces entre les deux
extract(brut,
into = c("date_raw", "Momentum_perc"),
regex = "^(\\d{8})\\s+([\\-\\.\\d]+)") %>%
# 5. Conversion dans les formats finaux
mutate(
date = ymd(date_raw),
Momentum_perc = as.numeric(Momentum_perc),
# Traitement des valeurs aberrantes (-99.99) et passage en format décimal
WML = ifelse(Momentum_perc <= -99, NA, Momentum_perc / 100)
) %>%
# On isole les colonnes propres et on retire les quelques NA restants
select(date, WML) %>%
drop_na()
# Vérification
head(df_mom_clean)
View(df_mom_clean)
raw_ff3 <- read_csv("F-F_Research_Data_Factors_daily.csv", skip = 4, show_col_types = FALSE)
# 2. Nettoyage de la base de données
df_ff3_clean <- raw_ff3 %>%
# La première colonne contenant la date n'a pas de nom dans le fichier de Kenneth French.
# R va l'appeler "...1". On la renomme en pointant sa position (colonne 1).
rename(date_raw = 1) %>%
# On convertit en caractère au cas où R l'aurait lue comme un entier
mutate(date_raw = as.character(date_raw)) %>%
# On filtre pour ne garder que les lignes où la colonne commence par "19" ou "20" (suivi de 6 chiffres)
# Cela permet d'éliminer automatiquement le message de copyright à la fin du fichier !
filter(str_detect(date_raw, "^(19|20)\\d{6}$")) %>%
mutate(
# Formatage de la date (YYYY-MM-DD)
date = ymd(date_raw),
# Remplacement des valeurs manquantes (-99.99) par des NA,
# et conversion des pourcentages en format décimal pour TOUTES les colonnes numériques
across(
.cols = c(`Mkt-RF`, SMB, HML, RF),
.fns = ~ ifelse(.x <= -99, NA, .x / 100)
)
) %>%
# On sélectionne les colonnes finales et on retire les éventuels NA
select(date, `Mkt-RF`, SMB, HML, RF) %>%
drop_na()
# Aperçu de la base propre
head(df_ff3_clean)
base_regression <- df_final %>%
inner_join(df_ff3_clean, by = "date") %>%
inner_join(df_mom_clean, by = "date") %>%
# Étape cruciale : calculer le rendement excédentaire de Google (Rendement - Taux sans risque)
mutate(
Ret_Exc_GOOGL = Ret_GOOGL - RF
)
# Affichage de votre base finale
head(base_regression)
write_csv(base_regression)
write_csv(file = "Final_data",base_regression)
df <- read_csv("Final_data")

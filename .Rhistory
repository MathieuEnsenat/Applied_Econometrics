library(tidyquant)
library(dplyr)
library(tidyr)
# 1. Téléchargement des données (ajustez les dates selon votre besoin)
# On démarre un jour plus tôt pour pouvoir calculer le rendement du premier jour
tickers <- c("GOOGL", "^VIX")
raw_data <- tq_get(tickers,
get  = "stock.prices",
from = "2004-08-18",
to   = "2023-12-31")
# 1. Téléchargement des données (ajustez les dates selon votre besoin)
# On démarre un jour plus tôt pour pouvoir calculer le rendement du premier jour
tickers <- c("GOOGL", "^VIX")
raw_data <- tq_get(tickers,
get  = "stock.prices",
from = "2004-08-18",
to   = "2023-12-31")
# 2. Préparation et calculs
df_final <- raw_data %>%
# On ne garde que la date, le symbole, et le prix de clôture ajusté
select(date, symbol, adjusted) %>%
# On bascule les données en format large (une colonne GOOGL, une colonne ^VIX)
pivot_wider(names_from = symbol, values_from = adjusted) %>%
# On renomme la colonne du VIX pour enlever l'accent circonflexe (plus facile à manipuler)
rename(VIX = `^VIX`) %>%
# On trie chronologiquement par sécurité
arrange(date) %>%
# 3. Calcul du rendement de Google et de la variation du VIX
mutate(
# Rendement arithmétique de Google : (Prix_t - Prix_t-1) / Prix_t-1
Ret_GOOGL = (GOOGL - lag(GOOGL)) / lag(GOOGL),
# Variation absolue du VIX : VIX_t - VIX_t-1
Delta_VIX = VIX - lag(VIX)
) %>%
# On supprime la première ligne qui contiendra des NA (à cause de la fonction lag)
drop_na()
# Affichage des premières lignes du résultat
head(df_final)
